# PasswordDesk — пример конфигурации. Скопируйте в .env и заполните своими значениями.
# .env НИКОГДА не коммитится (см. .gitignore).

# --- Microsoft Entra ID / O365 ---
O365_TENANT=contoso.onmicrosoft.com
O365_APP_ID=00000000-0000-0000-0000-000000000000
PW_BOT_MAILBOX=servicedesk@example.com
PW_BOT_TRIGGERS=frontdesk@example.com,it.support@example.com
PW_BOT_UPN_DOMAIN=example.com

# --- пароли и уведомления ---
PW_BOT_PW_PREFIX=Pw-
# токен Telegram-бота (алерты о сбоях); чат можно оставить пустым
TELEGRAM_BOT_TOKEN=
PW_BOT_TG_CHAT=

# --- LLM (OpenAI-совместимый эндпоинт) ---
# ВАЖНО: проверяйте каждую модель живым запросом к /chat/completions —
# наличие модели в каталоге /models не гарантирует, что она обслуживается.
PW_BOT_LLM_BASE=https://integrate.api.nvidia.com/v1
PW_BOT_LLM_MODELS=nvidia/nemotron-3-ultra-550b-a55b,deepseek-ai/deepseek-v4.1-flash

# --- каталоги ---
PW_BOT_HOME=/opt/password-bot
